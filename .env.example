# Copy these keys into your local .env and fill in private values.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET_KEY=replace-with-a-random-value-at-least-32-characters

# Local Conda / FastAPI configuration
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_REDIS_REQUIRED=false
ALLOWED_HOSTS=localhost,127.0.0.1
OLLAMA_API_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_PREDICT=700
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=5m
# Optional model-assisted claim check; adds an Ollama call and can reject supported answers.
RAG_CLAIM_VERIFICATION_ENABLED=true
# Retrieval performance knobs; tune with the held-out benchmark.
EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=16
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RERANKER_DEVICE=auto
RERANKER_BATCH_SIZE=8
# Provisional threshold used in the latest recorded evaluation. Recalibrate on held-out data.
RERANKER_SCORE_THRESHOLD=0.001
# Optional override; defaults to OLLAMA_MODEL.
RAG_VERIFIER_MODEL=
# Legacy originals are read from this directory only by the migration utility.
DOCUMENT_STORAGE_DIR=stored_documents
DOCUMENT_OCR_ENABLED=false
DOCUMENT_OCR_MAX_PAGES=20
RAG_EVAL_JUDGE_MODEL=qwen3.5:4b

# Docker API service uses Docker's host gateway for local Ollama.
OLLAMA_CONTAINER_API_URL=http://host.docker.internal:11434/api/chat
