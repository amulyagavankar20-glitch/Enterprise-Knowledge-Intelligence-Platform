# Copy these keys into your local .env and fill in private values.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET_KEY=replace-with-a-random-value-at-least-32-characters

# Local Conda / FastAPI configuration
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_REDIS_REQUIRED=false
ALLOWED_HOSTS=localhost,127.0.0.1
GENERATION_PROVIDER=ollama
OLLAMA_API_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=120
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
DOCUMENT_STORAGE_DIR=stored_documents

# Docker API service uses Docker's host gateway for local Ollama.
OLLAMA_CONTAINER_API_URL=http://host.docker.internal:11434/api/chat
